# DeepSeek API 配置示例
# 请复制此文件为 .env 并填入实际的 API Key
# 获取 API Key: https://platform.deepseek.com/api_keys

# 必需的：你的 DeepSeek API Key（格式为 sk-开头的32-64个字符）
DEEPSEEK_API_KEY=sk-your_actual_deepseek_api_key_here

# 可选：模型名称（默认为 deepseek-chat）
LLM_MODEL=deepseek-chat

# 可选：API 端点（默认为 https://api.deepseek.com）
OPENAI_BASE_URL=https://api.deepseek.com

# 备用选项：也可以使用 OpenAI API
# OPENAI_API_KEY=sk-your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1