# LLM API 配置示例
# 请复制此文件为 .env 并填入实际的 API Key
# 支持 DeepSeek、OpenAI、GitHub Copilot 三种 LLM 提供商

# ============================================
# LLM 提供商选择（可选值: github_copilot, deepseek, openai, auto）
# auto 表示自动检测（优先级: github_copilot > deepseek > openai）
# ============================================
LLM_PROVIDER=auto

# ============================================
# GitHub Copilot Chat API 配置
# 获取 Token: https://github.com/settings/tokens
# 需要创建带有 'copilot' scope 的 Personal Access Token
# 确保你的 GitHub 账户已订阅 GitHub Copilot
# ============================================
# 你的 GitHub Copilot Token（格式为 ghp_xxx 或 ghu_xxx）
# GITHUB_COPILOT_TOKEN=ghp_your_github_copilot_token_here

# GitHub Copilot 模型（默认为 gpt-4o-copilot）
# LLM_MODEL=gpt-4o-copilot

# ============================================
# DeepSeek API 配置
# 获取 API Key: https://platform.deepseek.com/api_keys
# ============================================
# 你的 DeepSeek API Key（格式为 sk-开头的32-64个字符）
DEEPSEEK_API_KEY=sk-your_actual_deepseek_api_key_here

# DeepSeek 模型名称（默认为 deepseek-chat）
LLM_MODEL=deepseek-chat

# DeepSeek API 端点（默认为 https://api.deepseek.com）
OPENAI_BASE_URL=https://api.deepseek.com

# ============================================
# OpenAI API 配置（备用选项）
# 获取 API Key: https://platform.openai.com/api-keys
# ============================================
# 你的 OpenAI API Key（格式为 sk-开头）
# OPENAI_API_KEY=sk-your_openai_api_key_here

# OpenAI 模型（默认为 gpt-4o-mini）
# LLM_MODEL=gpt-4o-mini

# OpenAI API 端点（默认为 https://api.openai.com/v1）
# OPENAI_BASE_URL=https://api.openai.com/v1
